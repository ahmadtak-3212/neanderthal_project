# Vivado IP output products are regenerated from the .xci; keep only the IP config and memory-init files
**/sources_1/ip/*/*
!**/sources_1/ip/*/*.xci
!**/sources_1/ip/*/*.coe
!**/sources_1/ip/*/*.mif

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# ---- Node / web ----
node_modules/
dist/
.next/
.env
.env.local

# ---- MATLAB ----
*.asv
*.autosave

